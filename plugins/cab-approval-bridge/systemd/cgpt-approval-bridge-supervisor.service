[Unit]
Description=CAB 2.1.15 — Superviseur persistant CAB
After=cgpt-approval-bridge-controller.service

[Service]
Type=simple
EnvironmentFile=%h/.config/cab-approval-bridge/controller.env
LoadCredential=opencode.password:%h/.config/cab-approval-bridge/opencode.password
ExecStart=/usr/bin/env node %h/.local/share/cab-approval-bridge/cgpt-approval-bridge-supervisor.mjs
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
