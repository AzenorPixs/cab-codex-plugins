[Unit]
Description=CAB 2.1.33 — Supervision web locale indépendante

[Service]
Type=simple
EnvironmentFile=%h/.config/cab-approval-bridge/monitor.env
LoadCredential=opencode.password:%h/.config/cab-approval-bridge/opencode.password
ExecStart=/usr/bin/env node %h/.local/share/cab-approval-bridge-monitor/scripts/cgpt-approval-bridge-monitor.mjs
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=3
UMask=0077
NoNewPrivileges=true

# Installation et démarrage explicites par /CAB start ; aucune activation au login.
